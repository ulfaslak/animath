# nginx for the local stack (docker-compose.local.yml): the server's config
# (../nginx.conf.template) without HTTPS and Let's Encrypt, on plain HTTP. How
# the game is served is the same file, ../app.conf.

worker_processes auto;

# nginx's own log, at the server's level (../nginx.conf.template).
error_log stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mathgame/http.conf;

    server {
        listen 80;
        server_name _;

        include /etc/nginx/mathgame/app.conf;
    }
}
