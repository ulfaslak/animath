# nginx on the prod server: HTTPS with certificates from Let's Encrypt, which
# nginx's own ACME module gets and renews over HTTP-01, in front of the app.
# The same setup as lawcel's nginx/nginx.conf.
#
# A template. At every start the nginx image renders it into
# /etc/nginx/nginx.conf, with ${MATHGAME_DOMAIN} from deploy.env
# (docker-compose.prod.yml). Each deploy applies a change to it, or to the
# files it includes (scripts/lib/nginx-apply.sh). How the game is served lives
# in app.conf, which the local stack's config shares (local/nginx.conf.template).

load_module modules/ngx_http_acme_module.so;

worker_processes auto;

# nginx's own log: starting and reloading, its workers, and the certificate
# module, which says why a certificate is missing or did not renew. None of
# these lines is about a request, so none names a client: the lines about
# requests and connections are http.conf's, and only at `emerg`. `notice`,
# not `warn`: the certificate module writes only what is more severe than the
# level named here, so at `warn` a renewal Let's Encrypt refused would leave
# no line (nginx 1.29.8, 2026-09-28).
error_log stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mathgame/http.conf;

    # Let's Encrypt. The account key and the certificates live in the
    # acme_data volume, so a recreated container keeps them. No contact
    # address: Let's Encrypt no longer mails about expiry, and the account
    # needs none.
    acme_issuer letsencrypt {
        uri                   https://acme-v02.api.letsencrypt.org/directory;
        state_path            /etc/nginx/acme;
        accept_terms_of_service;
    }

    acme_shared_zone zone=ngx_acme_shared:1M;

    # HTTP -> HTTPS, always to the game's own name. The ACME module answers
    # Let's Encrypt's HTTP-01 challenges here too, for both names, before
    # `location /` sees the request.
    server {
        listen 80;
        server_name ${MATHGAME_DOMAIN} www.${MATHGAME_DOMAIN};

        location / {
            return 301 https://${MATHGAME_DOMAIN}$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name ${MATHGAME_DOMAIN};

        acme_certificate letsencrypt;
        ssl_certificate       $acme_certificate;
        ssl_certificate_key   $acme_certificate_key;
        ssl_certificate_cache max=2;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        # HSTS starts at 5 minutes, not a year: a TLS mistake on a new domain
        # then locks browsers out for minutes, not months. Raise it once HTTPS
        # has been steady: 300 -> 86400 -> 604800 -> 2592000 -> 31536000;
        # includeSubDomains last; never `preload`. (lawcel's ramp.)
        add_header Strict-Transport-Security "max-age=300" always;

        include /etc/nginx/mathgame/app.conf;
    }

    # www: a certificate of its own, and every request sent on to the game's
    # own name. Only redirected, never served: a kid's game is saved under the
    # address the page came from, so a game at www would be a second, empty one.
    # Its own certificate, so a missing www record costs only www. The record is
    # a CNAME to the domain (.claude/commands/redeploy.md).
    server {
        listen 443 ssl;
        server_name www.${MATHGAME_DOMAIN};

        acme_certificate letsencrypt;
        ssl_certificate       $acme_certificate;
        ssl_certificate_key   $acme_certificate_key;
        ssl_certificate_cache max=2;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        return 301 https://${MATHGAME_DOMAIN}$request_uri;
    }
}
