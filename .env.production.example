# Copy to ~/mathgame/.env.production on the prod server (gitignored, never
# committed) and fill in a password. The app, Postgres and the backup sidecar
# all read it (docker-compose.prod.yml). Its only other copy is the offsite one
# in ~/mathgame-backups/ on the Mac (scripts/sync-backups.sh).

# Postgres container credentials. Generate the password:
#   openssl rand -base64 24 | tr -d '/+='
POSTGRES_USER=mathgame
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mathgame

# The app's connection: same user, password and database as above. `postgres`
# is the Postgres service's name on the compose network.
DATABASE_URL=postgres://mathgame:CHANGE_ME@postgres:5432/mathgame
