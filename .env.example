# Copy to .env (gitignored). gtr copies .env into every worktree.

# Local Postgres from docker-compose.yml. Port 5433 on purpose: 5432 is taken by
# the lawcel dev database on this machine.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mathgame

# Server port. The Vite dev server (5180) proxies /api and /ws here.
PORT=3000
